        <item>
            <title>1.0.2</title>
            <pubDate>Thu, 12 Nov 2026 16:56:36 -0500</pubDate>
            <sparkle:version>4</sparkle:version>
            <sparkle:shortVersionString>1.0.2</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>15.0</sparkle:minimumSystemVersion>
            <description sparkle:format="markdown"><![CDATA[The Report Downloader now appears in the macOS Apps list. It still starts in the menu bar with the Dock icon hidden. To show the Dock icon, open the gear menu and select **Show in Dock**.
]]></description>
            <enclosure url="https://github.com/cybercrs/authors-ledger-report-downloader-downloads/releases/download/v1.0.2/ReportDownloader-1.0.2-4.zip" length="276282219" type="application/octet-stream" sparkle:edSignature="ERRfMPkWUCCaKoA+jSIq0iUO2YEZK4WHZrc5TqpSX9NIuw+jBgN0vvoQpcrNg/RKkB/sTpeenGKHPAO1YqW9Cw=="/>
        </item>
        <item>
            <title>1.0.1</title>
            <pubDate>Thu, 12 Nov 2026 12:03:00 -0500</pubDate>
            <sparkle:version>3</sparkle:version>
            <sparkle:shortVersionString>1.0.1</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>15.0</sparkle:minimumSystemVersion>
            <description sparkle:format="markdown"><![CDATA[- The downloader stays in the menu bar with its Dock icon hidden by default. Open the gear menu and select **Show in Dock** to show the icon.
- Barnes & Noble Press setup explains the macOS Keychain request before opening the included Chromium browser. Choose **Skip Barnes & Noble** to leave those downloads off. You can set them up later. Google Chrome isn’t required.
]]></description>
            <enclosure url="https://github.com/cybercrs/authors-ledger-report-downloader-downloads/releases/download/v1.0.1/ReportDownloader-1.0.1-3.zip" length="276282283" type="application/octet-stream" sparkle:edSignature="hGX2SwZgeYg6KYQQwWrLS2V1wzKML/MP7KJa34r/9a6OXGvzUp6fiVdMIm5ze9HD+6Wc/STopeI2yY49C1u2DQ=="/>
        </item>
        <item>
            <title>1.0</title>
            <pubDate>Thu, 12 Nov 2026 07:58:48 -0500</pubDate>
            <sparkle:version>2</sparkle:version>
            <sparkle:shortVersionString>1.0</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>15.0</sparkle:minimumSystemVersion>
            <description sparkle:format="markdown"><![CDATA[The first release of The Author’s Ledger Report Downloader for Mac. This free companion app automatically downloads available sales and royalty reports from supported distributors and delivers them to the iCloud Report Inbox for import into The Author’s Ledger.

Requires macOS 15 or later on Apple silicon or Intel. Unzip the download, move the app to Applications, and open it. Use the menu bar icon to set up the Report Inbox and sign in to your distributors.
]]></description>
            <enclosure url="https://github.com/cybercrs/authors-ledger-report-downloader-downloads/releases/download/v1.0/ReportDownloader-1.0-2.zip" length="276257546" type="application/octet-stream" sparkle:edSignature="pGgyCNv0xoWnSaU6pKyBCoSebcR8WxTrnKy1bmnXiwOqLy2WtvTELCXFDo+30/V3ogtei7XAFpwuPoVM4acUDg=="/>
        </item>

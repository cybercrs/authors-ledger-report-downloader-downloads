        <item>
            <title>1.0.4</title>
            <pubDate>Thu, 12 Nov 2026 22:44:41 -0500</pubDate>
            <sparkle:version>6</sparkle:version>
            <sparkle:shortVersionString>1.0.4</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>15.0</sparkle:minimumSystemVersion>
            <description sparkle:format="markdown"><![CDATA[**Install and Relaunch** now remembers whether downloads were on and which report history option you chose. After the update, the downloader automatically restores that choice. If downloads were off, they stay off.
]]></description>
            <enclosure url="https://github.com/cybercrs/authors-ledger-report-downloader-downloads/releases/download/v1.0.4/ReportDownloader-1.0.4-6.zip" length="276286170" type="application/octet-stream" sparkle:edSignature="HabyeM3yi89cOwgnbp4hfOa8XkopdHZ72WEGAoVm2qWFeC8oFSHK44dyxUG6e9uVgrsoEgU7VI7X9h+iLI4GBQ=="/>

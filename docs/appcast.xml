        <item>
            <title>1.0.5</title>
            <pubDate>Fri, 13 Nov 2026 07:20:17 -0500</pubDate>
            <sparkle:version>7</sparkle:version>
            <sparkle:shortVersionString>1.0.5</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>15.0</sparkle:minimumSystemVersion>
            <description sparkle:format="markdown"><![CDATA[When you sign in to a distributor from the menu bar, the downloader now returns to the dropdown when sign-in finishes. Sign-ins started from the main window return there.
]]></description>
            <enclosure url="https://github.com/cybercrs/authors-ledger-report-downloader-downloads/releases/download/v1.0.5/ReportDownloader-1.0.5-7.zip" length="276289061" type="application/octet-stream" sparkle:edSignature="Ce1CtPI476GXrNDA6tlt3WiD6nbVAXlNJtvZssWedcJhzlnwhmHvnWAZLko+XbvgIs4yAxOE9s5wrqYUZO7VAQ=="/>
